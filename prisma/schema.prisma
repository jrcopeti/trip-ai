// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trip {
  id Int @id @default(autoincrement())
  userName String
  travellers String
  ageRanges String[]
  pace String
  passport String?
  type String
  city String
  country String
  countryCode String
  lat Float
  lng Float
  startDate DateTime
  endDate DateTime
  luggageSize String
  accommodation String
  transport String
  requiredItems String[]
  interests String[]
  note String?
  budget String
  agreement Boolean
  byWeather Boolean @default(false)
  tripUrl String @unique
  tripImages String[]
  placeholder String?
  saved Boolean @default(false)
  title String
  description String @db.Text
  objectsList Json?
  mustHave String[]
  tours Json?
  tip String
  createdAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saved, createdAt])
}
