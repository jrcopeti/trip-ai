# Copy to `.env.local` and fill in. Never commit real values.

# The app's database. Points at production on the deployed site; locally, point it at
# a database you don't mind writing to.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

ANTHROPIC_API_KEY=""
UNSPLASH_API_KEY=""
OPEN_WEATHER_KEY=""
GEONAMES_USERNAME=""

# --- e2e only (`npm run test:e2e`, `seed:e2e`, `db:push:e2e`) ---
# Defaults to the local `trip-ai-e2e-pg` container; the e2e tooling ignores DATABASE_URL.
# Set it here (or in the shell) only if your test database lives elsewhere.
# E2E_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trip_ai_e2e"
# Lets the seed and push scripts write to a non-local host. Leave unset.
# ALLOW_REMOTE_E2E_SEED=1
